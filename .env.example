# Copy to .env and fill in. .env is gitignored, so never commit real values.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=dayzwiki
DB_USER=root
DB_PASSWORD=change-me
# Outgoing mail (defaults: Resend SMTP, smtp.resend.com:587, username "resend")
MAIL_PASSWORD=your-resend-api-key
# MAIL_HOST=smtp.resend.com
# MAIL_PORT=587
# MAIL_USERNAME=resend
# Address used in email links; use http://localhost:8080 when testing locally
# DAYZWIKI_URL=https://thmirk.com
JWTSecretKey=change-me-to-a-long-random-string
